# --- Database -----------------------------------------------------------------
# Development: SQLite file, relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL, e.g. Neon), used with prisma/postgres/schema.prisma:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"   # pooled
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"                    # direct, for migrations

# --- Site ---------------------------------------------------------------------
# Absolute base URL, used for Open Graph links and the seed script's printed links.
# NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# --- Rate limits (per client IP) -----------------------------------------------
# RATE_LIMIT_CREATE_PER_HOUR=10
# RATE_LIMIT_WRITES_PER_MINUTE=120
